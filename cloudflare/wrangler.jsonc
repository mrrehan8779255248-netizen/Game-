{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "island-arena-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ARENA_ROOMS", "class_name": "ArenaRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArenaRoom"] }
  ]
}