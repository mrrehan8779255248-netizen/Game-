# Browser-visible WebSocket URL for the Cloudflare Durable Object game server
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:8787

# Server-only MongoDB Atlas connection string for database "islandarena"
MONGODB_URI=
MONGODB_DB=islandarena

# Optional secret to protect trusted match-ingestion requests; set server-side only
MATCH_INGEST_SECRET=
